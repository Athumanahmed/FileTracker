FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

EXPOSE 3001

# Source is bind-mounted over /app at runtime (see docker-compose.dev.yml),
# so Vite HMR picks up live edits. --host so the dev server accepts
# connections from outside the container.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
