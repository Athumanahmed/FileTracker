PORT=5051

NODE_ENV=development

# postgresql://<user>:<password>@<host>:5432/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/FileTrackerDb?schema=public

# Generate two DIFFERENT strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES=15m

JWT_REFRESH_EXPIRES=7d

JWT_RESET_TOKEN_SECRET=

JWT_RESET_TOKEN_EXPIRES=10m

BCRYPT_SALT_ROUNDS=12

JWT_ISSUER=eftms-tabora-mc

JWT_AUDIENCE=eftms-clients

ACCOUNT_LOCK_MAX_ATTEMPTS=5

ACCOUNT_LOCK_DURATION=30m

LOGIN_RATE_LIMIT_WINDOW=15m

LOGIN_RATE_LIMIT_MAX=10

REFRESH_RATE_LIMIT_WINDOW=15m

REFRESH_RATE_LIMIT_MAX=30

GLOBAL_RATE_LIMIT_WINDOW=15m

GLOBAL_RATE_LIMIT_MAX=300

REFRESH_TOKEN_COOKIE_NAME=eftms_refresh_token

CSRF_COOKIE_NAME=eftms_csrf_token

OTP_EXPIRY=5m

OTP_MAX_ATTEMPTS=5

FORGOT_PASSWORD_RATE_LIMIT_WINDOW=15m

FORGOT_PASSWORD_RATE_LIMIT_MAX=3

VERIFY_OTP_RATE_LIMIT_WINDOW=5m

VERIFY_OTP_RATE_LIMIT_MAX=5

RESEND_OTP_RATE_LIMIT_WINDOW=15m

RESEND_OTP_RATE_LIMIT_MAX=3

RESET_PASSWORD_RATE_LIMIT_WINDOW=15m

RESET_PASSWORD_RATE_LIMIT_MAX=3

FORCE_CHANGE_PASSWORD_RATE_LIMIT_WINDOW=15m

FORCE_CHANGE_PASSWORD_RATE_LIMIT_MAX=5


CLIENT_URL=http://localhost:3000

SMTP_HOST=

SMTP_PORT=

SMTP_USER=

SMTP_PASSWORD=

SMS_API_KEY=

MINIO_ENDPOINT=

MINIO_ACCESS_KEY=

