PORT=5051

NODE_ENV=development

# postgresql://<user>:<password>@<host>:5432/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/FileTrackerDb?schema=public

# Generate two DIFFERENT strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES=15m

JWT_REFRESH_EXPIRES=7d

JWT_RESET_TOKEN_SECRET=

JWT_RESET_TOKEN_EXPIRES=10m

BCRYPT_SALT_ROUNDS=12

JWT_ISSUER=eftms-tabora-mc

JWT_AUDIENCE=eftms-clients

ACCOUNT_LOCK_MAX_ATTEMPTS=5

ACCOUNT_LOCK_DURATION=30m

LOGIN_RATE_LIMIT_WINDOW=15m

LOGIN_RATE_LIMIT_MAX=10

REFRESH_RATE_LIMIT_WINDOW=15m

REFRESH_RATE_LIMIT_MAX=30

GLOBAL_RATE_LIMIT_WINDOW=15m

GLOBAL_RATE_LIMIT_MAX=300

REFRESH_TOKEN_COOKIE_NAME=eftms_refresh_token

CSRF_COOKIE_NAME=eftms_csrf_token

OTP_EXPIRY=5m

OTP_MAX_ATTEMPTS=5

FORGOT_PASSWORD_RATE_LIMIT_WINDOW=15m

FORGOT_PASSWORD_RATE_LIMIT_MAX=3

VERIFY_OTP_RATE_LIMIT_WINDOW=5m

VERIFY_OTP_RATE_LIMIT_MAX=5

RESEND_OTP_RATE_LIMIT_WINDOW=15m

RESEND_OTP_RATE_LIMIT_MAX=3

RESET_PASSWORD_RATE_LIMIT_WINDOW=15m

RESET_PASSWORD_RATE_LIMIT_MAX=3

FORCE_CHANGE_PASSWORD_RATE_LIMIT_WINDOW=15m

FORCE_CHANGE_PASSWORD_RATE_LIMIT_MAX=5

SEARCH_RATE_LIMIT_WINDOW=1m

SEARCH_RATE_LIMIT_MAX=30


CLIENT_URL=http://localhost:3000

# Public citizen file-tracking portal (separate app -- see citizen-portal/).
# Used as the link inside the citizen SMS milestone alerts -- BUT the link is
# only included when this is a real public https:// host. SMS gateways' spam
# filters reject any message containing http:// / localhost / a bare IP (Beem
# returns 403), so in dev the SMS just carries the tracking number.
# On the VPS set e.g. CITIZEN_PORTAL_URL=https://track.tabora.go.tz
CITIZEN_PORTAL_URL=http://localhost:3001

# Comma-separated allowed CORS origins. Defaults to the internal client (3000)
# + the citizen portal (3001) when unset.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

SMTP_HOST=

SMTP_PORT=

SMTP_USER=

SMTP_PASSWORD=

SMS_API_KEY=

MINIO_ENDPOINT=localhost

MINIO_PORT=9000

MINIO_USE_SSL=false

MINIO_ACCESS_KEY=

MINIO_SECRET_KEY=

MINIO_REGION=us-east-1

MINIO_BUCKET_NAME=eftms-files

STORAGE_MAX_FILE_SIZE_BYTES=26214400

STORAGE_PRESIGNED_URL_EXPIRY_SECONDS=900

# redis://<host>:6379 locally; redis://redis:6379 when running via docker-compose
REDIS_URL=redis://localhost:6379


BEEM_AFRICA_API_KEY_SMS=

BEEM_AFRICA_SECRET_KEY_SMS=

BEEM_AFRICA_USERNAME=

BEEM_AFRICA_PASSWORD=

SENDER_ID=
